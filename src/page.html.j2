{% extends "_base.html.j2" %}
{% block ld %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ProfessionalService","name":"Cosmopolit Digital","url":"{{ site_url }}/","logo":"{{ site_url }}/assets/img/icon-512.png","image":"{{ site_url }}/assets/img/og.jpg","description":{{ t.description|tojson }},"telephone":"+{{ phone_intl }}","email":"{{ email }}","address":{"@type":"PostalAddress","addressLocality":"Sarajevo","addressCountry":"BA"},"areaServed":["BA","AT","DE","CH"],"founder":{"@type":"Person","name":"Haris Hadrović","sameAs":"https://www.linkedin.com/in/harishadrovic"},"sameAs":["https://www.instagram.com/cosmopolit.digital/"],"knowsLanguage":["bs","en","de"]}
</script>
{% endblock %}
{% block main %}

<!-- HERO -->
<section class="hero-v2">
  <div class="wrap">
    <h1 class="display">{{ t.h1|safe }}</h1>
    <div class="hero-row">
      <p class="hero-lead">{{ t.lead }}</p>
      <div class="hero-actions">
        <a class="btn btn-orange" href="#radovi">{{ t.heroBtn }} <span aria-hidden="true">↓</span></a>
        <a class="btn btn-line" href="https://wa.me/{{ phone_intl }}" target="_blank" rel="noopener">{{ t.heroWa }} {{ phone }}</a>
      </div>
    </div>
    <p class="hero-recent"><span>{{ t.recentLabel }}</span>{% for c in t.cases %}<a href="#case-{{ loop.index }}">{{ c.name }}</a>{% endfor %}</p>
  </div>
</section>

<!-- WORK -->
<section id="radovi" class="paper">
  <div class="wrap section-v2">
    <div class="sec-head">
      <h2 class="display-md">{{ t.workTitle }}</h2>
      <p>{{ t.workLead }}</p>
    </div>
    <div class="cases">
    {% for c in t.cases %}
    <article class="case{% if loop.index > 2 %} case-sm{% endif %}" id="case-{{ loop.index }}">
      <div class="case-visual">
        <div class="browser"><div class="browser-bar"><i></i><i></i><i></i><span>{{ c.domain }}</span></div>
          <img src="{{ root }}assets/img/{{ c.img }}-desktop.jpg" alt="{{ c.altD }}" width="1600" height="1000" {% if loop.index > 1 %}loading="lazy"{% else %}fetchpriority="high"{% endif %}></div>
        <div class="phone"><img src="{{ root }}assets/img/{{ c.img }}-mobile.jpg" alt="{{ c.altM }}" width="750" height="1630" loading="lazy"></div>
      </div>
      <div class="case-info">
        <div class="case-name"><h3>{{ c.name }}</h3><span>{{ c.place }}</span></div>
        <p class="case-text">{{ c.text }}</p>
        <div class="case-links">
          <a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.urlLabel }} <span aria-hidden="true">↗</span></a>
          {% if c.more %}<a href="{{ c.more }}">{{ c.moreLabel }} <span aria-hidden="true">→</span></a>{% endif %}
        </div>
      </div>
    </article>
    {% endfor %}
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="usluge" class="paper">
  <div class="wrap section-v2 section-tight">
    <div class="sec-head">
      <h2 class="display-md">{{ t.servicesTitle|safe }}</h2>
      <p>{{ t.servicesLead }}</p>
    </div>
    <div class="services">
      <div class="service">
        <h3>{{ t.webTitle }}</h3>
        <p class="service-text">{{ t.webText }}</p>
        <ul class="price-list">
          {% for n, d, p in t.webPrices %}<li><span><strong>{{ n }}</strong><small>{{ d }}</small></span><b>{{ p }}</b></li>{% endfor %}
        </ul>
        <p class="service-note">{{ t.webTerms }}</p>
      </div>
      <div class="service">
        <h3>{{ t.videoTitle }}</h3>
        <p class="service-text">{{ t.videoText }}</p>
        <ul class="price-list">
          {% for n, d, p in t.videoPrices %}<li><span><strong>{{ n }}</strong><small>{{ d }}</small></span><b>{{ p }}</b></li>{% endfor %}
        </ul>
        <p class="service-note">{{ t.videoIncl }}</p>
        <p class="service-note">{{ t.videoExtra }}</p>
      </div>
    </div>
  </div>
</section>

<!-- VIDEO DETAIL -->
<section class="dark-v2">
  <div class="wrap section-v2 video-detail">
    <div>
      <h3 class="label-h">{{ t.stepsTitle }}</h3>
      <ol class="steps-v2">{% for s, d in t.steps %}<li><b>{{ loop.index }}</b><span><strong>{{ s }}</strong>{{ d }}</span></li>{% endfor %}</ol>
    </div>
    <div>
      <h3 class="label-h">{{ t.gearTitle }}</h3>
      <div class="gear-v2">
        {% for img, n, d in t.gear %}<figure><img src="{{ root }}assets/img/{{ img }}.jpg" alt="{{ n }}" width="400" height="370" loading="lazy"><figcaption><strong>{{ n }}</strong>{{ d }}</figcaption></figure>{% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- SOLUTIONS -->
<section id="rjesenja" class="paper">
  <div class="wrap section-v2">
    <div class="sec-head">
      <h2 class="display-md">{{ t.solTitle|safe }}</h2>
      <p>{{ t.solLead }}</p>
    </div>
    <div class="solutions">
      {% for href, n, d in t.solutions %}
      <a class="solution" href="{{ href }}"><span><strong>{{ n }}</strong><small>{{ d }}</small></span><i aria-hidden="true">→</i></a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="o-meni" class="paper">
  <div class="wrap section-v2 section-tight about-v2">
    <img src="{{ root }}assets/img/haris.jpg" alt="{{ t.aboutAlt }}" width="800" height="1000" loading="lazy">
    <div>
      <h2 class="display-md">{{ t.aboutTitle }}</h2>
      {% for p in t.aboutParas %}<p>{{ p }}</p>{% endfor %}
      <p class="about-sign"><strong>{{ t.aboutSign }}</strong>, {{ t.aboutRole }}</p>
    </div>
  </div>
</section>
{% endblock %}
