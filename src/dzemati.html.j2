{% extends "_base.html.j2" %}
{% block ld %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Service","name":{{ t.title|tojson }},"description":{{ t.description|tojson }},"url":"{{ site_url }}{{ t.path }}","inLanguage":"{{ t.lang }}","serviceType":"Web design","areaServed":["AT","DE","CH","BA"],"offers":{"@type":"Offer","price":"1800","priceCurrency":"EUR"},"provider":{"@type":"ProfessionalService","name":"Cosmopolit Digital","url":"{{ site_url }}/","telephone":"+{{ phone_intl }}","email":"{{ email }}"}}
</script>
{% endblock %}
{% block main %}

<!-- HERO -->
<section class="lp-hero">
  <div class="wrap">
    <div>
      <p class="kicker">{{ t.eyebrow }}</p>
      <h1 class="display">{{ t.h1|safe }}</h1>
      <p class="lp-lead">{{ t.lead }}</p>
      <div class="lp-actions">
        <a class="btn btn-orange" href="#kontakt">{{ t.cta }}</a>
        <a class="btn btn-line" href="https://dzematizetnanic.com" target="_blank" rel="noopener">{{ t.heroCta2 }} <span aria-hidden="true">↗</span></a>
      </div>
      <p class="lp-note">{{ t.heroNote }}</p>
    </div>
    <div class="lp-visual">
      <div class="browser"><div class="browser-bar"><i></i><i></i><i></i><span>admin</span></div>
        <img src="{{ root }}assets/img/dz/admin-home.jpg" alt="{{ t.altHero }}" width="1400" height="875" fetchpriority="high"></div>
      <div class="phone"><img src="{{ root }}assets/img/dz/admin-mobile.jpg" alt="{{ t.altAdminMobile }}" width="750" height="1630"></div>
    </div>
  </div>
</section>

<div class="paper">
<!-- PROBLEM -->
<section class="wrap section-v2">
  <div class="sec-head"><h2 class="display-md">{{ t.problemTitle }}</h2></div>
  <ul class="rows">
    {% for p in t.problems %}<li><strong>{{ p.t }}</strong><span>{{ p.s }}</span></li>{% endfor %}
  </ul>
</section>

<!-- COST -->
<section id="troskovi" class="wrap section-v2 section-tight">
  <div class="sec-head"><h2 class="display-md">{{ t.costTitle }}</h2><p>{{ t.costLead }}</p></div>
  <div class="cost-grid">
    {% for o in t.costOptions %}
    <div class="cost-card{% if o.hot %} hot{% endif %}">
      <h3>{{ o.name }}</h3>
      <p class="amount">{{ o.price }}</p>
      <p class="cost-unit">{{ o.unit }}</p>
      <ul class="cost-points">{% for x in o.points %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>

  <div class="payback">
    <h3>{{ t.paybackTitle }}</h3>
    <p>{{ t.paybackLead }}</p>
    <div class="pb-legend"><span><i class="pb-a"></i>{{ t.paybackA }}</span><span><i class="pb-b"></i>{{ t.paybackB }}</span></div>
    <div class="pb-rows">
      {% for r in t.paybackRows %}
      <div class="pb-row">
        <span class="pb-year">{{ r.year }}</span>
        <div class="pb-bars">
          <div class="pb-bar pb-a" style="width:{{ (r.a / 6000 * 100)|round(1) }}%"><span>{{ "{:,}".format(r.a).replace(",", ".") if t.lang == 'bs' else "{:,}".format(r.a) }} €</span></div>
          <div class="pb-bar pb-b" style="width:{{ (r.b / 6000 * 100)|round(1) }}%"><span>{{ "{:,}".format(r.b).replace(",", ".") if t.lang == 'bs' else "{:,}".format(r.b) }} €</span></div>
        </div>
      </div>
      {% endfor %}
    </div>
    <p class="pb-note">{{ t.paybackNote }}</p>
  </div>

  <div class="why-list">
    <h3 class="display-md" style="font-size:clamp(26px,2.8vw,36px);max-width:760px">{{ t.whyTitle }}</h3>
    <div style="max-width:720px">{% for p in t.whyText %}<p style="margin-top:16px;color:var(--ink-2);font-size:17px;line-height:1.7">{{ p }}</p>{% endfor %}</div>
  </div>
  <p class="cost-src">{{ t.costSources }}</p>
</section>

<!-- FEATURES -->
<section id="funkcije" class="wrap section-v2 section-tight">
  <div class="sec-head"><h2 class="display-md">{{ t.featTitle }}</h2><p>{{ t.featLead }}</p></div>
  <div class="features">
    {% for b in t.blocks %}
    <article class="feature{% if loop.index is even %} flip{% endif %}">
      <div class="feature-copy">
        <p class="num">{{ b.tag }}</p>
        <h3>{{ b.t }}</h3>
        <p>{{ b.s }}</p>
      </div>
      <div class="feature-shot"><img src="{{ root }}assets/img/dz/{{ b.img }}.jpg" alt="{{ b.alt }}" width="1400" height="875" loading="lazy"></div>
    </article>
    {% endfor %}
  </div>

  <h3 style="margin-top:104px;margin-bottom:20px;font-size:26px;font-weight:500;letter-spacing:-.02em">{{ t.moreTitle }}</h3>
  <ul class="more-grid">
    {% for m in t.more %}<li><strong>{{ m.t }}</strong><span>{{ m.s }}</span></li>{% endfor %}
  </ul>
</section>

<!-- VALUE -->
<section id="vrijednost" class="wrap section-v2 section-tight">
  <div class="sec-head"><h2 class="display-md" style="max-width:820px">{{ t.valueTitle }}</h2><p>{{ t.valueLead }}</p></div>
  <div class="value-table">
    <div class="vt-row vt-head"><span>{{ t.valueColA }}</span><span>{{ t.valueColB }}</span><span>{{ t.valueColC }}</span></div>
    {% for r in t.valueRows %}
    <div class="vt-row"><span><strong>{{ r.t }}</strong><small>{{ r.s }}</small></span><span class="vt-else">{{ r.b }}</span><span class="vt-us">{{ r.c }}</span></div>
    {% endfor %}
    <div class="vt-row vt-total"><span>{{ t.valueTotalA }}</span><span class="vt-else">{{ t.valueTotalB }}</span><span class="vt-us">{{ t.valueTotalC }}</span></div>
  </div>
  <div class="value-extra">
    <div><h3>{{ t.valueExtraTitle }}</h3><p>{{ t.valueExtraText }}</p></div>
    <p class="value-extra-price">{{ t.valueExtraPrice }}</p>
  </div>
</section>
</div>

<!-- PHONES + PRICE -->
<section id="cijena" class="dark-v2">
  <div class="wrap section-v2">
    <div class="phones-row" style="margin-bottom:104px">
      <div class="phone-pair">
        <img src="{{ root }}assets/img/dz/admin-mobile.jpg" alt="{{ t.altAdminMobile }}" width="750" height="1630" loading="lazy">
        <div><h3>{{ t.mobileTitle }}</h3><p>{{ t.mobileText }}</p></div>
      </div>
      <div class="phone-pair">
        <img src="{{ root }}assets/img/dz/site-clanstvo.jpg" alt="{{ t.altSite }}" width="750" height="1630" loading="lazy">
        <div><h3>{{ t.siteTitle }}</h3><p>{{ t.siteText }}</p></div>
      </div>
    </div>

    <div class="price-block">
      <div>
        <h2 class="display-md">{{ t.priceTitle }}</h2>
        <ul class="price-incl">{% for x in t.priceIncl %}<li>{{ x }}</li>{% endfor %}</ul>
      </div>
      <div class="price-big">
        <p class="price-big-main">{{ t.priceMain }}</p>
        <p class="price-big-alt">{{ t.priceAlt }}</p>
        <p class="price-big-reg">{{ t.priceRegular }}</p>
        <a class="btn btn-orange" href="#kontakt">{{ t.cta }}</a>
      </div>
    </div>
    <ul class="terms-v2">
      {% for x in t.terms %}<li><strong>{{ x.t }}</strong><span>{{ x.s }}</span></li>{% endfor %}
    </ul>

    <div class="two-col">
      <div>
        <h3 class="label-h">{{ t.stepsTitle }}</h3>
        <ol class="steps-v2">{% for s in t.steps %}<li><b>{{ loop.index }}</b><span><strong>{{ s.t }}</strong>{{ s.s }}</span></li>{% endfor %}</ol>
      </div>
      <div>
        <h3 class="label-h">{{ t.faqTitle }}</h3>
        <div class="faq">
          {% for f in t.faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
