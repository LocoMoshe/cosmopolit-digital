<!doctype html>
<html lang="{{ t.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t.title }}</title>
<meta name="description" content="{{ t.description }}">
<meta name="theme-color" content="#0A0A22">
<link rel="canonical" href="{{ site_url }}{{ t.path }}">
<link rel="alternate" hreflang="bs" href="{{ site_url }}/ordinacije/">
<link rel="alternate" hreflang="en" href="{{ site_url }}/en/ordinacije/">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ t.title }}">
<meta property="og:description" content="{{ t.description }}">
<meta property="og:image" content="{{ site_url }}/assets/img/og.jpg">
<meta property="og:url" content="{{ site_url }}{{ t.path }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="{{ root }}favicon-32.png">
<link rel="apple-touch-icon" href="{{ root }}apple-touch-icon.png">
<link rel="preload" href="{{ root }}assets/fonts/poppins-bold.woff" as="font" type="font/woff" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/css/site.css?v={{ css_v }}">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Service","name":{{ t.title|tojson }},"description":{{ t.description|tojson }},"url":"{{ site_url }}{{ t.path }}","inLanguage":"{{ t.lang }}","serviceType":"Web design and video for dental clinics","areaServed":["BA"],"provider":{"@type":"ProfessionalService","name":"Cosmopolit Digital","url":"{{ site_url }}/","telephone":"+{{ phone_intl }}","email":"{{ email }}"}}
</script>
</head>
<body>
<a class="skip" href="#main">{{ t.skip }}</a>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ home }}" aria-label="Cosmopolit Digital">
      <img src="{{ root }}assets/img/logo-mark.png" alt="" width="34" height="38">
      <span>COSMOPOLIT DIGITAL</span>
    </a>
    <nav class="nav" id="nav" aria-label="{{ t.navLabel }}">
      <a href="{{ home }}">{{ t.navHome }}</a>
      <a href="#stranica">{{ t.navFeatures }}</a>
      <a href="#video">{{ t.navVideo }}</a>
      <a href="#cijene">{{ t.navPrice }}</a>
      <a href="#kontakt">{{ t.navContact }}</a>
      <div class="nav-lang">
        {% if t.lang == 'bs' %}<span aria-current="true">BS</span><a href="{{ root }}en/ordinacije/" lang="en" hreflang="en">EN</a>
        {% else %}<a href="{{ root }}ordinacije/" lang="bs" hreflang="bs">BS</a><span aria-current="true">EN</span>{% endif %}
      </div>
    </nav>
    <div class="header-right">
      <div class="lang">
        {% if t.lang == 'bs' %}<span aria-current="true">BS</span><a href="{{ root }}en/ordinacije/" lang="en" hreflang="en">EN</a>
        {% else %}<a href="{{ root }}ordinacije/" lang="bs" hreflang="bs">BS</a><span aria-current="true">EN</span>{% endif %}
      </div>
      <a class="btn btn-orange" href="#kontakt">{{ t.cta }}</a>
      <button class="menu-btn" type="button" aria-controls="nav" aria-expanded="false" aria-label="{{ t.menu }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<main id="main">

<!-- HERO -->
<section class="hero has-mark">
  <img class="mark" src="{{ root }}assets/img/logo-mark.png" alt="" aria-hidden="true" style="right:-180px;top:40px">
  <div class="wrap">
    <div class="hero-copy">
      <p class="eyebrow">{{ t.kicker }}</p>
      <h1 class="h-xl" style="font-size:clamp(40px,4.8vw,66px)">{{ t.h1 }}</h1>
      <p class="lead">{{ t.lead }}</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
        <a class="btn btn-orange" href="#kontakt">{{ t.cta }}</a>
        <a class="btn btn-ghost" href="https://stomatolog-ganibegovic.loco-moshe.workers.dev" target="_blank" rel="noopener">{{ t.heroCta2 }} {{ arrow_sm|safe }}</a>
      </div>
      <p class="sub" style="margin-top:18px;font-size:14px">{{ t.heroNote }}</p>
    </div>
    <div class="hero-visual">
      <div class="devices">
        <div class="browser"><div class="browser-bar"><i></i><i></i><i></i><span>stomatolog.ba</span></div>
          <img src="{{ root }}assets/img/stomatolog-desktop.jpg" alt="{{ t.altD }}" width="800" height="500" fetchpriority="high"></div>
        <div class="phone"><img src="{{ root }}assets/img/stomatolog-mobile.jpg" alt="{{ t.altM }}" width="375" height="812"></div>
      </div>
    </div>
  </div>
</section>

<div class="light">
<!-- WHAT PATIENTS WANT -->
<section class="wrap section">
  <p class="eyebrow" style="margin-bottom:16px">{{ t.problemEyebrow }}</p>
  <h2 class="h-md" style="max-width:760px">{{ t.problemTitle }}</h2>
  <div class="grid-2" style="margin-top:40px">
    {% for a, b in t.problems %}
    <div class="card-light audience"><h3 style="font-size:20px">{{ a }}</h3><p class="muted">{{ b }}</p></div>
    {% endfor %}
  </div>
</section>

<!-- FEATURES -->
<section id="stranica" class="wrap section" style="padding-top:88px">
  <p class="eyebrow" style="margin-bottom:16px">{{ t.featEyebrow }}</p>
  <h2 class="h-lg" style="max-width:820px">{{ t.featTitle }}</h2>
  <p class="sub" style="margin-top:18px;max-width:620px;font-size:17px">{{ t.featLead }}</p>
  <div class="features">
    {% for b in t.blocks %}
    <article class="feature{% if loop.index is even %} flip{% endif %}">
      <div class="feature-copy">
        <p class="tag">{{ b.num }}</p>
        <h3>{{ b.t }}</h3>
        <p class="muted">{{ b.s }}</p>
      </div>
      <div class="feature-shot phones">
        {% for img, alt in b.imgs %}<img src="{{ root }}assets/img/ord/{{ img }}.jpg" alt="{{ alt }}" width="600" height="1216" loading="lazy">{% endfor %}
      </div>
    </article>
    {% endfor %}
  </div>
  <h3 class="h-sm" style="margin-top:96px;margin-bottom:28px">{{ t.moreTitle }}</h3>
  <ul class="more-grid">
    {% for a, b in t.more %}<li><strong>{{ a }}</strong><span class="muted">{{ b }}</span></li>{% endfor %}
  </ul>
</section>
</div>

<!-- VIDEO -->
<section id="video" class="video has-mark">
  <img class="mark" src="{{ root }}assets/img/logo-mark.png" alt="" aria-hidden="true" style="left:-220px;top:80px;width:640px;opacity:.04">
  <div class="wrap" style="padding-bottom:104px">
    <p class="eyebrow">{{ t.videoEyebrow }}</p>
    <h2 class="h-lg" style="margin-top:16px">{{ t.videoTitle }}</h2>
    <p class="sub" style="font-size:18px">{{ t.videoLead }}</p>
    <div class="grid-3" style="margin-top:48px">
      {% for a, b in t.videoIdeas %}<div class="box"><h3 style="font-size:20px">{{ a }}</h3><p class="note" style="font-size:16px">{{ b }}</p></div>{% endfor %}
    </div>
    <div class="grid-2" style="margin-top:20px">
      <div class="box gear"><img src="{{ root }}assets/img/gear-c100.jpg" alt="Canon C100 II" width="400" height="370" loading="lazy"><div><p class="eyebrow">{{ 'KAMERA' if t.lang == 'bs' else 'CAMERA' }}</p><h3>Canon C100 II</h3></div></div>
      <div class="box gear"><img src="{{ root }}assets/img/gear-mini5.jpg" alt="DJI Mini 5 Pro" width="400" height="370" loading="lazy"><div><p class="eyebrow">{{ 'DRON' if t.lang == 'bs' else 'DRONE' }}</p><h3>DJI Mini 5 Pro</h3></div></div>
    </div>
  </div>
</section>

<!-- PRICES -->
<div class="light">
<section id="cijene" class="wrap section" style="padding-bottom:112px">
  <p class="eyebrow" style="margin-bottom:16px">{{ t.priceEyebrow }}</p>
  <div class="section-head">
    <h2 class="h-lg">{{ t.priceTitle }}</h2>
    <p class="muted">{{ t.priceLead }}</p>
  </div>
  <h3 class="terms-title" style="margin-top:8px;margin-bottom:18px">{{ t.priceWeb }}</h3>
  <div class="grid-3 web-prices">
    {% for n, d, p in t.webPrices %}<div class="card-light price"><h3>{{ n }}</h3><p class="amount" style="font-size:32px">{{ p }}</p><p class="muted desc">{{ d }}</p></div>{% endfor %}
  </div>
  <h3 class="terms-title" style="margin-bottom:18px">{{ t.priceVideo }}</h3>
  <div class="grid-3 web-prices">
    {% for n, d, p in t.videoPrices %}<div class="card-light price"><h3>{{ n }}</h3><p class="amount" style="font-size:32px">{{ p }}</p><p class="muted desc">{{ d }}</p></div>{% endfor %}
  </div>
  <ul class="terms" style="margin-top:56px">
    {% for a, b in t.terms %}<li><strong>{{ a }}</strong><span class="muted">{{ b }}</span></li>{% endfor %}
  </ul>
</section>
</div>

<!-- STEPS + FAQ -->
<section class="video">
  <div class="wrap" style="padding-bottom:104px">
    <div class="split" style="margin-top:0">
      <div>
        <p class="eyebrow" style="margin-bottom:8px">{{ t.stepsEyebrow }}</p>
        <h3 class="h-sm" style="margin-bottom:28px">{{ t.stepsTitle }}</h3>
        <ol class="steps">{% for s in t.steps %}<li><span class="num" aria-hidden="true">{{ loop.index }}</span><span><strong style="letter-spacing:0;font-size:19px">{{ s.t }}</strong><span>{{ s.s }}</span></span></li>{% endfor %}</ol>
      </div>
      <div>
        <h3 class="h-sm" style="margin-bottom:24px">{{ t.faqTitle }}</h3>
        <div class="faq">
          {% for f in t.faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="kontakt" class="contact">
  <div class="wrap">
    <div>
      <p class="eyebrow" style="margin-bottom:14px">{{ t.contactEyebrow }}</p>
      <h2 class="h-xl" style="font-size:clamp(38px,4.6vw,62px)">{{ t.contactTitle }}</h2>
      <p class="muted" style="margin-top:22px;font-size:18px;line-height:1.6;max-width:480px">{{ t.contactText }}</p>
    </div>
    <div>
      <a class="phone-card" href="https://wa.me/{{ phone_intl }}?text={{ t.waText|urlencode }}" target="_blank" rel="noopener"><small>VIBER / WHATSAPP</small><strong>{{ phone }}</strong></a>
      <div class="contact-links">
        <a class="btn btn-ghost" href="viber://chat?number=%2B{{ phone_intl }}">{{ viber_icon|safe }}Viber</a>
        <a class="btn btn-ghost" href="mailto:{{ email }}">{{ mail_icon|safe }}{{ email }}</a>
      </div>
    </div>
  </div>
</section>
</main>

<footer class="site-footer">
  <div class="wrap">
    <a href="{{ home }}" style="letter-spacing:.04em">{{ t.footerBack }}</a>
    <span style="letter-spacing:.04em">© {{ year }} · Cosmopolit Digital</span>
  </div>
</footer>

<script>
(function(){
  var b=document.querySelector('.menu-btn'),n=document.getElementById('nav');
  if(!b||!n)return;
  b.addEventListener('click',function(){var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o)});
  n.addEventListener('click',function(e){if(e.target.tagName==='A'){n.classList.remove('open');b.setAttribute('aria-expanded','false')}});
})();
</script>
</body>
</html>
